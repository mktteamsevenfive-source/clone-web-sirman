<!doctype html><html lang="en"><head><base href="/"/><meta build-version="2026-06-30_11:07:12"/><meta version="2026-06-30_11:07:12"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"/><meta http-equiv="X-UA-Compatible" content="IE=edge"/><script async src="https://cdn.jsdelivr.net/npm/pwacompat" crossorigin="anonymous"></script><style>body,html{height:100%;margin:0;padding:0}body{position:relative}#before-root{height:100%;overflow-x:hidden}.loader--hide{display:none!important}.container{overflow:hidden;position:absolute;top:0;width:100%;height:100vh;background-color:#fff;margin:0;display:flex}.drawer{position:absolute;width:248px;left:16px;top:8px;height:calc(100vh - 16px)}.inner-container{display:flex;flex-direction:column}.body{position:absolute;top:80px;right:16px;left:16px;margin-left:auto;margin-right:auto;width:calc(100% - 32px);height:208px;max-width:960px}.header{position:absolute;top:8px;right:16px;left:16px;height:48px;width:calc(100% - 32px)}.footer{position:fixed;bottom:16px;right:16px;left:16px;height:48px;width:calc(100% - 32px)}.gradient{animation-duration:.8s;animation-fill-mode:forwards;animation-iteration-count:infinite;animation-name:placeHolderShimmer;animation-timing-function:linear;background:#f6f7f8;background:linear-gradient(to right,#fafafa 8%,#f4f4f4 38%,#fafafa 84%);background-size:1000px 640px}@media screen and (max-width:1280px){.drawer{display:none}}@media screen and (min-width:1280px){.footer{display:none}}@keyframes placeHolderShimmer{0%{background-position:-468px 0}100%{background-position:468px 0}}</style><script defer="defer" src="/static/js/main.07646396.js"></script><link href="/static/css/main.c3cba0ed.css" rel="stylesheet"></head><body><noscript>You need to enable JavaScript to run this app.</noscript><div id="before-root"><div id="root"></div><div class="container"><div class="inner-container"><div class="gradient header"></div><div class="gradient body"></div><div class="gradient footer"></div></div></div></div></body></html>